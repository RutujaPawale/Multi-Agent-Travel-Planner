# ==========================================
# Multi-Agent AI Travel Planner - Environment Variables
# ==========================================

# Duffel API Credentials (v2 / Test Mode)
# Get your test token at: https://duffel.com
# Example test token format: duffel_test_...
DUFFEL_API_KEY=your_duffel_api_key_here

# Provider Selection (duffel | mock)
# Defaults to mock if DUFFEL_API_KEY is not configured
FLIGHT_PROVIDER=duffel
HOTEL_PROVIDER=duffel

# Lodging Budget Allocation Percentage (default: 35%)
HOTEL_BUDGET_PCT=35.0

# PostgreSQL Configuration
POSTGRES_DB=travel_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Internal Service Ports & URLs
AGENT_SERVICE_PORT=8000
API_SERVICE_PORT=8080
DASHBOARD_PORT=3000
