# ==========================================
# Multi-Agent AI Travel Planner - Environment Variables
# ==========================================

# Duffel API Credentials (v2 / Test Mode)
# Get your test token at: https://duffel.com
# Example test token format: duffel_test_...
DUFFEL_API_KEY=your_duffel_api_key_here

# Flight & Hotel Provider Selection (duffel | mock)
# Defaults to mock if DUFFEL_API_KEY is not configured
FLIGHT_PROVIDER=duffel
HOTEL_PROVIDER=duffel

# OpenTripMap API Credentials (https://opentripmap.io - free API key, no billing required)
# Used by Activity Agent to fetch points of interest & attractions
# Leave empty to automatically use realistic mock places
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here
ACTIVITY_PROVIDER=opentripmap

# LLM Planning Credentials
# Used by Activity Agent for day-by-day itinerary synthesis
# Supported LLM_PROVIDER: gemini | openai
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Budget Allocation Percentages
# Percentage of total budget allocated to lodging (default: 35%)
HOTEL_BUDGET_PCT=35.0
# Percentage of total budget allocated to activities (default: 20%)
ACTIVITY_BUDGET_PCT=20.0

# PostgreSQL Configuration
POSTGRES_DB=travel_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Internal Service Ports & URLs
AGENT_SERVICE_PORT=8000
API_SERVICE_PORT=8080
DASHBOARD_PORT=3000
